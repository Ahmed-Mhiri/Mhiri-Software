---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en" class="bg-neutral-950 text-neutral-100 antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen flex flex-col justify-between relative overflow-x-hidden selection:bg-emerald-500 selection:text-black">
    {/* Ambient light glow */}
    <div class="absolute inset-0 glow-emerald pointer-events-none -z-10"></div>
    <div class="absolute inset-0 bg-grid-pattern opacity-40 pointer-events-none -z-10"></div>

    <header class="border-b border-neutral-800/60 bg-neutral-950/70 backdrop-blur-xl sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 font-semibold tracking-tight text-white hover:opacity-90 transition-opacity">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
          </span>
          <span class="tracking-wider text-sm font-mono uppercase text-neutral-200 font-bold">MHIRI SOFTWARE</span>
        </a>

        <nav class="flex items-center gap-6 text-sm text-neutral-400">
          <a href="#products" class="hover:text-white transition-colors">Products</a>
          <a href="#architecture" class="hover:text-white transition-colors">Architecture</a>
          <a 
            href="mailto:support@mhirisoftware.com" 
            class="px-3.5 py-1.5 rounded-lg bg-white/5 border border-white/10 hover:bg-white/10 text-neutral-200 text-xs font-medium tracking-wide transition-all shadow-sm"
          >
            Inquire
          </a>
        </nav>
      </div>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    <footer class="border-t border-neutral-900 bg-neutral-950 text-neutral-500 text-xs py-12">
      <div class="max-w-6xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="flex flex-col gap-1 text-center sm:text-left">
          <span class="text-neutral-300 font-mono font-medium">MHIRI SOFTWARE</span>
          <p class="text-neutral-600">&copy; {new Date().getFullYear()} Ahmed Mhiri. Engineered for Shopify Plus & mid-market brands.</p>
        </div>
        <div class="flex items-center gap-6">
          <a href="https://profitguard.mhirisoftware.com" class="hover:text-neutral-300 transition-colors">ProfitGuard</a>
          <a href="https://profitguard.mhirisoftware.com/privacy" class="hover:text-neutral-300 transition-colors">Privacy Policy</a>
          <a href="mailto:support@mhirisoftware.com" class="text-emerald-500 hover:text-emerald-400 transition-colors font-mono">support@mhirisoftware.com</a>
        </div>
      </div>
    </footer>
  </body>
</html>